---
import BaseLayout from './BaseLayout.astro';
import MetricStat from '../components/MetricStat.astro';
import { caseStudies, site, resumePath } from '../content/site';

interface Props {
  slug: string;
  title: string;
  description: string;
  role: string;
  timeframe: string;
  metrics: { value: string; label: string }[];
}

const { slug, title, description, role, timeframe, metrics } = Astro.props;

const index = caseStudies.findIndex((s) => s.slug === slug);
const study = caseStudies[index];
const prev = index > 0 ? caseStudies[index - 1] : undefined;
const next = index < caseStudies.length - 1 ? caseStudies[index + 1] : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
  },
};
---

<BaseLayout title={`${title} — ${site.name}`} description={description} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <article>
    <header class="mx-auto max-w-5xl px-6 pb-4 pt-20 md:pt-28">
      <p class="eyebrow">
        Case study{study ? ` · ${study.eyebrow}` : ''}
      </p>
      <h1 class="mt-5 max-w-3xl font-serif text-4xl leading-[1.08] text-balance text-ink md:text-5xl">
        {title}
      </h1>
      <p class="mt-5 font-sans text-sm text-lavender">{role} · {timeframe}</p>
      <div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-8 border-b border-hairline pb-10 sm:grid-cols-3">
        {metrics.map((m) => <MetricStat value={m.value} label={m.label} size="md" />)}
      </div>
    </header>

    <div class="case-prose mx-auto max-w-prose px-6 pb-24 pt-10">
      <slot />
    </div>
  </article>

  <nav aria-label="More case studies" class="border-t border-hairline">
    <div class="mx-auto flex max-w-5xl flex-col gap-6 px-6 py-12 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-col gap-2 font-serif text-base">
        {
          prev && (
            <a href={`/work/${prev.slug}`} class="text-ink-soft hover:text-ink">
              ← {prev.title}
            </a>
          )
        }
        {
          next && (
            <a href={`/work/${next.slug}`} class="text-ink-soft hover:text-ink">
              {next.title} →
            </a>
          )
        }
      </div>
      <a href={resumePath} class="btn btn-secondary shrink-0">Download resume</a>
    </div>
  </nav>
</BaseLayout>
