---
interface Props {
  name: string;
  href: string;
  domain: string;
  description: string;
  note?: string;
  icon?: string;
  appStore?: string;
  // Mac apps get the "Mac App Store" badge, per Apple's badge guidelines.
  platform?: 'mac';
  // Meta Horizon Store listing. Meta publishes no store badge, so ours is drawn to match Apple's.
  quest?: string;
  status?: string;
}

const { name, href, domain, description, note, icon, appStore, platform, quest, status } = Astro.props;
const store = platform === 'mac' ? 'Mac App Store' : 'App Store';
const badge = platform === 'mac' ? '/projects/mac-app-store-badge.svg' : '/projects/app-store-badge.svg';
---

<div class="flex flex-col border-t border-hairline pt-5">
  <div class="flex items-center gap-3">
    {icon && <img src={icon} alt="" width="40" height="40" class="size-10 rounded-xs" loading="lazy" />}
    <div>
      <h3 class="font-serif text-lg text-ink">{name}</h3>
      {note && <p class="font-sans text-xs text-lavender">{note}</p>}
    </div>
  </div>
  <p class="mt-4 font-sans text-sm leading-relaxed text-ink-soft">{description}</p>
  <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-5 font-sans text-sm">
    <a href={href} target="_blank" rel="noopener" class="link">
      {domain} ↗
    </a>
    {
      appStore && (
        <a href={appStore} target="_blank" rel="noopener" class="shrink-0">
          <img src={badge} alt={`Download ${name} on the ${store}`} height="36" class="h-9 w-auto" loading="lazy" />
        </a>
      )
    }
    {
      quest && (
        <a href={quest} target="_blank" rel="noopener" class="shrink-0">
          <img src="/projects/meta-quest-badge.svg" alt={`Get ${name} on Meta Quest from the Meta Horizon Store`} height="36" class="h-9 w-auto" loading="lazy" />
        </a>
      )
    }
    {
      !appStore && status && (
        <span class="inline-flex h-9 shrink-0 items-center rounded-[7.5px] border border-dashed border-hairline-strong px-3 text-xs text-ink-soft">
          {status}
        </span>
      )
    }
  </div>
</div>
