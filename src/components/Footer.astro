---
import { site, socials, resumePath } from '../content/site';
---

<footer id="contact" class="border-t border-hairline">
  <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
    <p class="eyebrow">Contact</p>
    <h2 class="mt-4 font-serif text-3xl text-ink">Let's talk.</h2>
    <p class="mt-4 max-w-xl font-serif text-lead text-ink-soft">
      Open to senior product roles. The fastest way to reach me is email.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3">
      <a href={`mailto:${site.email}`} class="link">{site.email}</a>
      <a
        href={resumePath}
        class="font-sans text-sm text-ink underline decoration-hairline-strong underline-offset-4 hover:decoration-ink"
      >
        Download resume (PDF)
      </a>
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-hairline pt-8 font-sans text-sm">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank" class="text-ink-mute hover:text-ink">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="text-ink-mute">© {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>
