---
import { site, socials, resumePath } from '../content/site';
---

<footer id="contact" class="border-t border-slate-800/70">
  <div class="mx-auto max-w-5xl px-6 py-16">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-rose-300">Contact</p>
    <h2 class="mt-3 font-display text-3xl text-white">Let's talk.</h2>
    <p class="mt-4 max-w-xl text-slate-400">
      Open to senior product roles. The fastest way to reach me is email.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3">
      <a
        href={`mailto:${site.email}`}
        class="text-rose-400 underline decoration-rose-400/40 underline-offset-4 hover:text-rose-300"
      >
        {site.email}
      </a>
      <a
        href={resumePath}
        class="text-slate-300 underline decoration-slate-600 underline-offset-4 hover:text-white"
      >
        Download resume (PDF)
      </a>
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-slate-800/70 pt-8">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                rel="me noopener"
                target="_blank"
                class="text-slate-400 hover:text-white"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="text-sm text-slate-500">© {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>
