---
import { resumePath } from '../content/site';
---

<header class="sticky top-0 z-40 border-b border-slate-800/70 bg-slate-950/80 backdrop-blur">
  <nav
    aria-label="Main"
    class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6"
  >
    <a href="/" class="font-display text-lg text-white hover:text-rose-300">
      <span class="hidden sm:inline">Edson Ayllon</span>
      <span class="sm:hidden">EA</span>
    </a>
    <div class="flex items-center gap-5 text-sm sm:gap-7">
      <a href="/#work" class="text-slate-300 hover:text-white">Work</a>
      <a href="/#projects" class="text-slate-300 hover:text-white">Projects</a>
      <a href="/#contact" class="text-slate-300 hover:text-white">Contact</a>
      <a
        href={resumePath}
        class="rounded-full border border-rose-400/40 px-4 py-1.5 font-medium text-rose-300 transition-colors hover:border-rose-300 hover:text-rose-200"
      >
        Resume
      </a>
    </div>
  </nav>
</header>
