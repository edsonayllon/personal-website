---
import type { CaseStudy } from '../content/site';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

<a
  href={`/work/${study.slug}`}
  class="group grid gap-x-8 gap-y-3 py-8 md:grid-cols-[11rem_minmax(0,1fr)_auto] md:py-10"
>
  <p class="eyebrow">{study.eyebrow}</p>
  <div>
    <h3 class="font-serif text-2xl leading-snug text-ink group-hover:text-seaglass-deep">
      {study.title}
    </h3>
    <p class="mt-2 max-w-prose font-serif text-base leading-relaxed text-ink-soft">{study.outcome}</p>
  </div>
  <p class="font-sans text-sm font-medium text-seaglass tabular-nums md:text-right">
    {study.metric} <span aria-hidden="true">→</span>
  </p>
</a>
