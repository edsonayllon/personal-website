---
interface Props {
  value: string;
  label: string;
  context?: string;
  size?: 'lg' | 'md';
}

const { value, label, context, size = 'lg' } = Astro.props;
---

<div>
  <p
    class:list={[
      'font-display text-white tabular-nums',
      size === 'lg' ? 'text-4xl md:text-5xl' : 'text-3xl',
    ]}
  >
    {value}
  </p>
  <div class="mt-2 h-px w-8 bg-rose-400"></div>
  <p class="mt-3 text-sm font-medium text-slate-200">{label}</p>
  {context && <p class="mt-1 text-sm text-slate-400">{context}</p>}
</div>
