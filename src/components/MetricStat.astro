---
interface Props {
  value: string;
  label: string;
  context?: string;
  size?: 'lg' | 'md';
}

const { value, label, context, size = 'lg' } = Astro.props;
---

<div class="border-t border-hairline pt-5">
  <p
    class:list={[
      'font-serif leading-none text-ink tabular-nums',
      size === 'lg' ? 'text-5xl md:text-6xl' : 'text-4xl',
    ]}
  >
    {value}
  </p>
  <p class="mt-4 font-sans text-sm font-medium text-ink">{label}</p>
  {context && <p class="mt-1 font-sans text-sm text-ink-soft">{context}</p>}
</div>
