---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="scroll-mt-20 border-t border-hairline">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="mt-4 font-serif text-3xl leading-[1.1] text-ink md:text-4xl">{title}</h2>
    <div class="mt-12 md:mt-14">
      <slot />
    </div>
  </div>
</section>
