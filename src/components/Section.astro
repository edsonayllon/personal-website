---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="scroll-mt-20 border-t border-slate-800/70">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-24">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-rose-300">{eyebrow}</p>
    <h2 class="mt-3 font-display text-3xl text-white md:text-4xl">{title}</h2>
    <div class="mt-10 md:mt-12">
      <slot />
    </div>
  </div>
</section>
