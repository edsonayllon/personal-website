<CaseStudyLayout
  slug="ai-apps"
  title="Four AI products, four different AI architectures"
  description="Cleared, IronProof, Grava, and Delecto — four complete consumer apps shipped solo, each a deliberate bet on a different AI product architecture. All four are live on the App Store."
  role="Independent — design, product, engineering"
  timeframe="2026"
  metrics={[
    { value: '4', label: 'Complete products' },
