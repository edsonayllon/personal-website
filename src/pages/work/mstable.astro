<CaseStudyLayout
  slug="mstable"
  title="Relaunching a yield product to $3.5M in deposits on day one"
  description="Owning product and marketing for the mStable relaunch — positioning, launch sequencing, and co-promotion from Ethena, Aave, and the Ethereum Foundation."
  role="Product & Marketing Lead, mStable (at Chamber)"
  timeframe="2024 – 2025"
  metrics={[
