<CaseStudyLayout
  slug="retention"
  title="From 600 to 5,700 weekly returning users"
  description="How gamification, loss aversion, and incentive design turned a deposit product into a weekly habit — an 850% increase in returning users."
  role="Senior Product Manager, Chamber"
  timeframe="2024 – 2026"
  metrics={[
    { value: '600', label: 'Weekly returning users, before' },
    { value: '5,700', label: 'Weekly returning users, after' },
