---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---

<BaseLayout title={`Page not found — ${site.name}`} description="This page doesn't exist.">
  <div class="mx-auto flex max-w-5xl flex-col items-start px-6 py-32">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 font-serif text-5xl text-balance text-ink">This page doesn't exist.</h1>
    <p class="mt-4 font-serif text-lead text-ink-soft">The work, however, does.</p>
    <a href="/" class="btn btn-secondary mt-8">Back home</a>
  </div>
</BaseLayout>
