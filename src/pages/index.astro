---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import MetricStat from '../components/MetricStat.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  site,
  socials,
  resumePath,
  metrics,
  caseStudies,
  professionalProducts,
  personalProducts,
  experience,
} from '../content/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Senior Product Manager',
  description: site.description,
  email: `mailto:${site.email}`,
  url: site.url,
  sameAs: socials.map((s) => s.href),
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'The Pennsylvania State University',
  },
};
---

<BaseLayout title={site.title} description={site.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <!-- Hero -->
  <section class="wash-hero">
    <div class="mx-auto max-w-5xl px-6 pb-16 pt-24 md:pb-24 md:pt-36">
      <p class="eyebrow">Edson Ayllon · Senior Product Manager</p>
      <h1 class="mt-6 max-w-4xl font-serif text-display text-balance text-ink md:text-display-lg">
        I build financial products people trust with real money.
      </h1>
      <p class="mt-8 max-w-2xl font-serif text-lead text-ink-soft">
        Product leader with an engineering edge. Seven years across product and engineering, the
        last five shipping consumer financial products end to end — strategy, pricing, launches,
        and growth — most recently leading a cross-functional team of 10 as Senior Product Manager
        at Chamber. I started as a frontend engineer, and I still ship.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="#work" class="btn btn-primary">View my work</a>
        <a href={resumePath} class="btn btn-secondary">Download resume</a>
      </div>
      <ul class="mt-12 flex flex-wrap gap-x-6 gap-y-2 font-sans text-sm">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank" class="text-ink-mute hover:text-ink">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Metrics ledger -->
  <section aria-label="Career metrics" class="border-t border-hairline">
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-x-8 gap-y-10 px-6 py-16 sm:grid-cols-2 md:py-20 lg:grid-cols-4">
      {metrics.map((m) => <MetricStat value={m.value} label={m.label} context={m.context} />)}
    </div>
  </section>

  <!-- Case studies -->
  <Section id="work" eyebrow="Selected work" title="Case studies">
    <ol class="divide-y divide-hairline border-y border-hairline">
      {
        caseStudies.map((study) => (
          <li>
            <CaseStudyCard study={study} />
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Live products -->
  <Section id="projects" eyebrow="Proof of shipping" title="Live products">
    <h3 class="eyebrow">As product leader</h3>
    <div class="mt-5 grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-3">
      {
        professionalProducts.map((p) => (
          <ProjectCard
            name={p.name}
            href={p.href}
            domain={p.domain}
            description={p.description}
          />
        ))
      }
    </div>
    <h3 class="eyebrow mt-14">As independent builder — three AI apps, 2026</h3>
    <div class="mt-5 grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-3">
      {
        personalProducts.map((p) => (
          <ProjectCard
            name={p.name}
            href={p.href}
            domain={p.domain}
            description={p.description}
            note={p.note}
            icon={p.icon}
            appStore={'appStore' in p ? p.appStore : undefined}
          />
        ))
      }
    </div>
    <p class="mt-8 font-sans text-sm text-ink-mute">
      How and why I built these three →
      <a href="/work/ai-apps" class="link">read the case study</a>.
    </p>
  </Section>

  <!-- Experience -->
  <Section id="experience" eyebrow="Background" title="Experience">
    <ol class="divide-y divide-hairline border-t border-hairline">
      {
        experience.map((job) => (
          <li class="grid gap-x-8 gap-y-1 py-7 md:grid-cols-[11rem_minmax(0,1fr)]">
            <p class="font-sans text-sm text-ink-mute tabular-nums">{job.period}</p>
            <div>
              <h3 class="font-serif text-lg text-ink">
                {job.role} <span class="text-ink-soft">· {job.company}</span>
              </h3>
              {job.summary && (
                <p class="mt-2 max-w-prose font-sans text-sm leading-relaxed text-ink-soft">{job.summary}</p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>
</BaseLayout>
